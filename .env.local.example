OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_RECOGNITION_MODEL=gpt-5.4-mini
OPENAI_RECOGNITION_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_STRATEGY_MODEL=gpt-5.6-terra
OPENAI_RECOGNITION_REASONING_EFFORT=none
OPENAI_STRATEGY_REASONING_EFFORT=none
OPENAI_IMAGE_DETAIL=high
OPENAI_LIVE_IMAGE_DETAIL=low
OPENAI_RECOGNITION_IMAGE_DETAIL=low
SHOP_PREVIEW_MODE=false
SHOP_HOST_ROUTING=false
# Only this organization is allowed to publish into the public RAMROD shop.
SHOP_ORGANIZATION_SLUG=creators
SERPAPI_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ramrod-item-images

# Set true on the public VPS. Keep false only for local development.
AUTH_REQUIRED=false
# Optional comma-separated allowlist for the first internal users.
AUTH_ALLOWED_EMAILS=
# Accounts listed here receive the cross-customer platform view. Prefer the
# `ramrod_role=admin` app metadata or the platform_admins table in production.
RAMROD_PLATFORM_ADMIN_EMAILS=

# Hybrid worker. Keep the service-role key only on trusted servers/workers.
RAMROD_WORKER_KEY=mac-mini-link
RAMROD_WORKER_NAME=Mac mini CREATORS
RAMROD_WORKER_CAPABILITIES=health_check,price_check,ebay_draft,recognize_image,analyze_image
RAMROD_CONTROL_PLANE_URL=http://127.0.0.1:3001
RAMROD_WORKER_POLL_MS=1000
RAMROD_WORKER_LEASE_SECONDS=180
RAMROD_WORKER_TOKEN=
# On the public control plane, queue image analysis for the Mac mini worker.
RAMROD_IMAGE_ANALYSIS_MODE=worker
# hybrid tries the fast cloud recognizer first and queues local Qwen when the
# cloud is unavailable. Use worker to keep all recognition local.
RAMROD_RECOGNITION_MODE=hybrid

# Local image analysis on the Mac mini. Keep Ollama bound to localhost;
# the worker downloads queued images and calls it locally.
RAMROD_IMAGE_ANALYSIS_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b-instruct
OLLAMA_RECOGNITION_MODEL=qwen3-vl:2b-instruct
OLLAMA_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=10m
# Enable only after OpenAI billing works and a deliberate cloud fallback is wanted.
RAMROD_IMAGE_CLOUD_FALLBACK=false

EBAY_ENV=sandbox
EBAY_PRICE_PROVIDER=local
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_OAUTH_USER_TOKEN=
EBAY_AUTH_N_AUTH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_PAYMENT_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=creators-warehouse-01
